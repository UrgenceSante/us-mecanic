<Project>
  <PropertyGroup>
    <!-- Version applicative : maintenue automatiquement par release-please (cf. release-please-config.json) -->
    <Version>0.0.25</Version> <!-- x-release-please-version -->

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Qualité : les avertissements (analyseurs inclus) cassent le build -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 : documentation XML non obligatoire sur chaque membre public -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
