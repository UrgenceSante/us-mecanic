root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,xml,csproj,props,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:suggestion
csharp_style_var_for_built_in_types = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0005.severity = warning   # using inutiles
dotnet_diagnostic.IDE0161.severity = warning   # namespace file-scoped

# Les noms de méthodes de test contiennent des underscores
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
