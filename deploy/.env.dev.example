# Environnement dev : suit la branche dev (image "dev" republiée à chaque push)
APP_ENV_NAME=dev
IMAGE_TAG=dev
WEB_PORT=3020
API_PORT=3030
ASPNETCORE_ENVIRONMENT=Staging

# Front (vide = valeur par défaut embarquée dans l'image)
# URL publique de l'API us-mecanic (port API_PORT), ex. https://us-mecanic-api.example.fr
APP_API_URL=
APP_LEGACY_API_URL=
APP_GEOLOC_API_URL=
APP_MAP_STYLE_URL=
APP_KEYCLOAK_URL=https://auth.ade-dev.fr/
APP_KEYCLOAK_REALM=ustest
APP_KEYCLOAK_CLIENT_ID=us-mecanic
# Dev uniquement (ADR-0001) : saute la connexion Keycloak. Seule la valeur "true" désactive l'authentification.
APP_AUTH_DISABLED=true

# API
API_AUTH_AUTHORITY=https://auth.ade-dev.fr/realms/ustest
API_AUTH_AUDIENCE=
# Dev uniquement (ADR-0001) : lève l'authentification de l'API. Seule la valeur "true" la désactive ; ne jamais renseigner en prod.
API_AUTH_DISABLED=true
API_CORS_ORIGIN=

# Base PostgreSQL (conteneur "db", données dans le volume db-data)
DB_PASSWORD=a-changer
